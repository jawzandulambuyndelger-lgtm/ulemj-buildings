# Public canonical URL. Set to the real deployment domain before launch.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional trusted HTTPS endpoint accepting multipart/form-data.
# Leave empty until the company connects its CRM or email delivery service.
INQUIRY_WEBHOOK_URL=
INQUIRY_WEBHOOK_TOKEN=
# Set to true only after company privacy/content approval and webhook testing.
INQUIRY_DELIVERY_ENABLED=false
